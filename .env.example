# Neon PostgreSQL
DATABASE_URL=

# openssl rand -base64 32
AUTH_SECRET=

# Google Cloud Console > Credentials > OAuth client ID
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Comma-separated emails that get the moderator role automatically.
MODERATOR_EMAILS=

# Set for production deploys
# AUTH_URL=https://your-app.vercel.app

# Optional: Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
# Adds the GA4 tracking snippet to every page when set.
NEXT_PUBLIC_GA_ID=

# Optional: canonical site URL used by sitemap/robots/OG tags.
# Defaults to https://www.geriacare.in when unset.
NEXT_PUBLIC_SITE_URL=
